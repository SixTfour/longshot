# Copy this file to .env and fill in the two secrets. Never commit .env.

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# https://the-odds-api.com (the free plan is enough to start)
ODDS_API_KEY=

# Optional. Your server's ID makes slash commands appear instantly while testing.
GUILD_ID=

# Optional. Where the database lives. Defaults to %LOCALAPPDATA%\Longshot\longshot.db
# on Windows so that OneDrive does not sync a file the bot is writing to.
DB_PATH=

# Optional starting values. After first run, change these in Discord with /config.
# Times are US Eastern.
DEFAULT_DEADLINE=sat 21:00
DEFAULT_BONUS_DEADLINE=tue 21:00
DEFAULT_ANNOUNCE=tue 10:00
DEFAULT_REMINDERS=24,7,2
DEFAULT_SPORTSBOOK=draftkings
DEFAULT_STAKE=10
DEFAULT_CACHE_HOURS=12
